# ADMIN_PASSWORD: contraseña para entrar al CRM (OBLIGATORIA)
# Sin esta variable el login del CRM queda deshabilitado.
ADMIN_PASSWORD="elige-una-contrasena-fuerte"

# DEEPSEEK_API_KEY: motor principal del Chatbot Asesor RESEO STUDIO
DEEPSEEK_API_KEY="your_deepseek_api_key_here"

# OPENAI_API_KEY (opcional): motor alternativo del chatbot
OPENAI_API_KEY="your_openai_api_key_here"

# GEMINI_API_KEY (opcional): fallback del chatbot si no hay DeepSeek/OpenAI
GEMINI_API_KEY="your_gemini_api_key_here"

# PORT (opcional, por defecto 3000)
PORT=3000

# APP_URL (informativo): la URL donde está alojada la web
APP_URL="http://localhost:3000"
